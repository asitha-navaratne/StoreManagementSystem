VITE_BASE_URL=http://localhost:8000 # Base URL for the backend API

VITE_CLIENT_ID= # Replace with your actual client ID from Azure AD
VITE_REDIRECT_URI=http://localhost:5173/ # URI to redirect to after authentication, must match the one registered in Azure AD
VITE_TENANT_SUBDOMAIN=https://login.microsoftonline.com/common/ # Common endpoint for Azure AD